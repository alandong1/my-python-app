# 复制这个文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到 GitHub。这个 .env.example 只是模板，不要在这里写真实密钥。

# Neon 数据库连接字符串。留空则使用本地 SQLite 文件 dev.db
DATABASE_URL=

# 网站地址（OAuth 回调和邮件里的链接用）。本地开发用默认值即可
PUBLIC_BASE_URL=http://localhost:8000
# 线上 https 环境设为 1
COOKIE_SECURE=0

# ---- Google 登录（可选）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Apple 登录（可选，需要 Apple Developer 账号）----
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- 微信登录（可选，需要企业认证的微信开放平台账号）----
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- 发邮件（可选）。不填时验证链接会打印在服务器日志里 ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
